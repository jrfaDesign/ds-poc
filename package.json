{
  "name": "ds-poc2",
  "private": true,
  "scripts": {
    "clean": "rm -rf node_modules apps/*/node_modules packages/*/node_modules",
    "fresh": "yarn install",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "check-types": "turbo run check-types",
    "storybook": "yarn workspace storybook storybook",
    "tailwind-sample": "yarn workspace tailwind-sample dev",
    "native-sample": "yarn workspace app start"
  },
  "devDependencies": {
    "@storybook/react": "10.6.6",
    "@storybook/react-vite": "10.6.6",
    "prettier": "^3.7.4",
    "turbo": "^2.10.5",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "yarn@4.14.1",
  "resolutions": {
    "@types/react": "19.2.18"
  }
}
