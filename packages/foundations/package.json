{
	"name": "@repo/foundations",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./codegen": "./src/codegen.js"
	},
	"scripts": {
		"lint": "eslint . --max-warnings 0",
		"check-types": "tsc --noEmit",
		"generate:codegen": "node scripts/generate-codegen.mjs",
		"generate:tokens": "yarn generate:codegen && yarn --cwd ../ui-web-tailwind generate:theme-css",
		"verify:codegen": "node scripts/verify-codegen.mjs"
	},
	"dependencies": {
		"zod": "^3.23.8"
	},
	"devDependencies": {
		"@repo/eslint-config": "workspace:*",
		"@repo/typescript-config": "workspace:*",
		"typescript": "5.9.2"
	}
}
